# ==============================================================================
# Organization Phonebook — ตัวอย่างค่า Environment Variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าจริงจากโปรเจกต์ Supabase ของคุณ
# ห้าม commit ไฟล์ .env.local หรือค่าลับใด ๆ ขึ้น Git
# ==============================================================================

# Supabase Project URL และ Anon (public) Key — ดูได้ที่ Supabase Dashboard
# > Project Settings > API
# ค่าเหล่านี้ถูกเปิดเผยในฝั่ง Browser ได้ (ถูกจำกัดสิทธิ์ด้วย RLS อยู่แล้ว)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key — ใช้เฉพาะฝั่ง Server เท่านั้น (scripts/create-admin.ts,
# scripts/seed.ts) ห้ามนำไปใช้ในโค้ดฝั่ง Client หรือ commit ขึ้น Git โดยเด็ดขาด
# เพราะสามารถข้าม RLS ทั้งหมดได้
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ชื่อหน่วยงาน/องค์กรที่แสดงบนหน้า Dashboard
NEXT_PUBLIC_ORG_NAME=ชื่อหน่วยงานของคุณ

# ---- ใช้เฉพาะตอนรัน scripts/migrate.ts (npm run migrate) เท่านั้น ----
# รันไฟล์ migration อัตโนมัติผ่านการเชื่อมต่อฐานข้อมูลโดยตรง (Session Pooler)
# ไม่จำเป็นถ้าคุณจะ copy-paste SQL ทีละไฟล์ใน Supabase SQL Editor เอง
#
# วิธีที่ง่ายที่สุด: คัดลอกค่าจาก Dashboard > Settings > Database >
# Connection string > "Session pooler" มาใส่ตรง ๆ ที่ DATABASE_URL
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres
#
# หรือจะแยกตั้งค่าเองก็ได้ (ใช้สร้าง Session Pooler URL ข้างต้นให้อัตโนมัติ):
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_DB_REGION=ap-south-1
